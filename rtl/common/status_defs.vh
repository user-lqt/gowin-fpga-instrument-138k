`timescale 1ns/1ps
//=============================================================================
// status_defs.vh —— 系统状态与错误码
//
// 归属：成员 C 维护（rtl/common/），A、B 可读。
//       变更流程同 event_defs.vh。
//=============================================================================

`ifndef STATUS_DEFS_VH
`define STATUS_DEFS_VH

`define STATUS_DEFS_VERSION     8'd1

//-----------------------------------------------------------------------------
// 1. 就绪与锁定状态（均为电平、高有效；复位期间必须为 0）
//-----------------------------------------------------------------------------
// system_ready   顶层上电自检完成，可接受演奏输入
// engine_ready   A 的音频核心初始化完成（波表/参数就绪）
// input_ready    B 的输入扫描与传感器校准完成
// audio_locked   C 的采样节拍与 I2S 已稳定锁定
// i2s_active     I2S 正在输出（LRCK/BCK 持续翻转）
// 判定顺序建议：audio_locked -> engine_ready -> input_ready -> system_ready

//-----------------------------------------------------------------------------
// 2. 系统错误码（system_error，多热编码，任意一位为 1 即进入降级）
//-----------------------------------------------------------------------------
`define ERR_NONE                8'h00   // 无错误

`define ERR_CLK_UNLOCKED        8'h01   // PLL 未锁定
`define ERR_SAMPLE_TICK_LOST    8'h02   // 采样节拍丢失（看门狗）
`define ERR_I2S_UNDERRUN        8'h04   // 音频核心未按时提供采样
`define ERR_I2S_OVERFLOW        8'h08   // 采样供给过快（不应发生）
`define ERR_AUDIO_CLIP          8'h10   // 混音削波连续超阈值
`define ERR_INPUT_TIMEOUT       8'h20   // 输入链路无响应（传感器断线）
`define ERR_PARAM_RANGE         8'h40   // 参数越界被钳位（可恢复，仅告警）
`define ERR_RESERVED            8'h80   // 预留

// 降级策略（阶段 2 起必须实现）：
//   ERR_CLK_UNLOCKED / ERR_SAMPLE_TICK_LOST -> 静音并点亮错误 LED
//   ERR_I2S_UNDERRUN                        -> 输出静音样本，保持 I2S 不停
//   ERR_AUDIO_CLIP                          -> 自动降低总增益
//   ERR_INPUT_TIMEOUT                       -> 该维度回默认值，其余维度继续
//   任何错误都不得导致死机；必须能通过复位键恢复。

//-----------------------------------------------------------------------------
// 3. 活跃声部计数
//-----------------------------------------------------------------------------
`define VOICE_CNT_WIDTH         6
`define VOICE_CNT_ZERO          6'd0

// active_voice_count 的语义：包络未进入完全静音态的声部数量。
// 仅供 C 的 LED / OLED / 调试串口展示，不参与音频计算。

//-----------------------------------------------------------------------------
// 4. 合规相关约定（写入报告与答辩材料时必须引用）
//-----------------------------------------------------------------------------
// 本设计的全部音频样本均由 FPGA 按实时演奏指令逐音、逐样本生成。
// 严禁：直接播放预录 PCM 音频、预置推流、整段录音触发。
// 测试模式仅用于输出多路不同频率、便于频谱验证独立谱峰数量。

`endif // STATUS_DEFS_VH
