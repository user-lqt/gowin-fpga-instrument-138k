//=============================================================================
// tang_mega138k.cst —— 物理约束（管脚分配）
//
// 归属：成员 C 独占维护。
//
// 器件信息（已核实）：
//   DEVICE       : GW5AST-LV138PG484AC1/I0（Sipeed wiki 与综合工程一致；
//                 注：曾误抄官方例程 IP 文件头的 AC2/I1，仅为注释，不影响功能）
//   IDE 封装选择  : PBG484A
//   DEVICE VER   : C（2026-09-24 实物丝印核对；官方例程均为 B，勿照抄）
//   核对日期      : 2026-09-24
//
// 管脚依据（全部来自 Sipeed 官方例程，非推测）：
//   板载 50 MHz 晶振 V22  ：sd_card/eda_proj/src/pin.cst          -> IO_LOC "clk_50M" V22
//                          ws2812 / pwm_fan / joycon / hdmi 例程 -> IO_LOC "clk" V22
//   I2S 三线 + PA_EN     ：audio_i2s/eda_proj/src/audio.cst
//   S2 复位键 F4         ：audio_i2s/eda_proj/src/audio.cst
//   板载 LED 排           ：pmod_led/eda_proj/src/eda_proj.cst
//
// 仓库：https://github.com/sipeed/TangMega-138K-example
//
// 安全红线：外接 GPIO 只允许 3.3V；HC-SR04 的 ECHO 必须分压后接入。
//=============================================================================

//-----------------------------------------------------------------------------
// 板载 50 MHz 晶振  ★ 已核实
//   这是全系统唯一的时钟源：PLL 由它产生音频域 12.28814 MHz 与系统域 103.571 MHz
//-----------------------------------------------------------------------------
IO_LOC  "i_clk_in"  V22;
IO_PORT "i_clk_in"  IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

//-----------------------------------------------------------------------------
// I2S 音频输出  ★ 已核实（板载 DAC + 功放，不需要外置器件）
//   o_hp_bck = 位时钟 1.536 MHz（= 32 x 48 kHz，板载 DAC 的 16bit 槽格式）
//   o_hp_ws  = 声道选择，低电平 = 左声道
//   o_hp_din = DAC 串行数据
//   o_pa_en  = 板载音频功放控制，官方例程固定低电平常开
//-----------------------------------------------------------------------------
IO_LOC  "o_hp_bck"  Y17;
IO_PORT "o_hp_bck"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_hp_ws"   AB17;
IO_PORT "o_hp_ws"   IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_hp_din"  AA16;
IO_PORT "o_hp_din"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_pa_en"   AB16;
IO_PORT "o_pa_en"   IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

//-----------------------------------------------------------------------------
// S2 复位键  ★ 已核实（原始输入按下为高；RTL 内部取反为 rst_n）
//   S2 所在 BANK 的 VCCIO 为 1.5V，必须用 LVCMOS15
//-----------------------------------------------------------------------------
IO_LOC  "i_rst_n"  F4;
IO_PORT "i_rst_n"  IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;

//-----------------------------------------------------------------------------
// 状态指示  ★ 已核实：单颗 LED
//
// ⚠️ 重要教训：pmod_led 例程里那 16 个 LED 管脚（P19/R19/T21/U21/...）
//    属于 CPU / SSPI 专用脚，默认被系统功能占用。实测报错：
//      ERROR (PR2017): 'o_led[0]' cannot be placed ... dedicated pin (CPU/SSPI)
//    要用它们必须先在 IDE 里关掉对应的多功能 I/O 系统功能。
//    因此本设计先只用官方 audio 例程验证过的这颗灯。
//-----------------------------------------------------------------------------
IO_LOC  "o_led"    W21;
IO_PORT "o_led"    IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "o_locked" W22;
IO_PORT "o_locked" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

//=============================================================================
// 待办（阶段 2 补齐）
//   [ ] 若要使用板载 16 颗 LED：需先在 IDE 的"多功能 I/O"里关掉 CPU/SSPI 系统功能
//   [ ] 矩阵键盘 / EC11 编码器 / OLED 的可用 GPIO 排针管脚
//   [ ] 用户按键（除 S2 外的另外两个）管脚
//   [ ] UART 调试串口管脚
//=============================================================================

// J13 BANK2 keyboard and EC11. Check physical J13 orientation and 3.3 V before wiring.
// Rows are low or high impedance. Columns need external 10k pull-ups to 3.3 V.
IO_LOC "row_out[0]" E14;
IO_PORT "row_out[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "row_out[1]" E13;
IO_PORT "row_out[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "row_out[2]" C15;
IO_PORT "row_out[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "row_out[3]" C14;
IO_PORT "row_out[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "col_in[0]" B13;
IO_PORT "col_in[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "col_in[1]" C13;
IO_PORT "col_in[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "col_in[2]" A14;
IO_PORT "col_in[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "col_in[3]" A13;
IO_PORT "col_in[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// External 4.7k pull-ups are required for the three bare EC11 contacts.
IO_LOC "enc_a" B16;
IO_PORT "enc_a" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_b" B15;
IO_PORT "enc_b" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_sw_n" A16;
IO_PORT "enc_sw_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// SSD1306, 31005 Dock Rev1.3 J13-14/A15 and J13-15/A20 (B012 handoff).
// RTL drives only 0/Z. External 4.7k pull-ups must go to 3.3 V.
IO_LOC "oled_scl" A15;
IO_PORT "oled_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "oled_sda" A20;
IO_PORT "oled_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
