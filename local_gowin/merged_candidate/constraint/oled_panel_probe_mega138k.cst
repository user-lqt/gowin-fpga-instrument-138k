// Dedicated no-audio OLED probe for the 31005 Dock Rev1.3.
IO_LOC "i_clk_in" V22;
IO_PORT "i_clk_in" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "i_rst_n" F4;
IO_PORT "i_rst_n" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;
IO_LOC "oled_scl" A15;
IO_PORT "oled_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "oled_sda" A20;
IO_PORT "oled_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "o_led" W21;
IO_PORT "o_led" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "o_locked" W22;
IO_PORT "o_locked" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
