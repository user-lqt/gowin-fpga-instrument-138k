# ============================================================================
# .gitignore —— 高云 FPGA 实时多音色合成电子乐器
#
# 【2026-09-24 更新】仓库根目录迁至 E:\GowinProjects\synth_top 后，
#   Gowin 编译产物目录与 ModelSim 仿真库都直接位于工程根下，
#   必须补齐忽略规则，否则每次编译都会污染 git status（迁移时实测 75 条）。
#
# 原则：只提交人可读、可审查的源码级内容。
# ============================================================================

# ---------------------------------------------------------------------------
# 1) Gowin 云源软件的编译产物
#    project/synth_top/ 是工程工作目录，除 .gprj 外全是综合/布线/报告产物。
#    只保留 .gprj，其余全部忽略。
# ---------------------------------------------------------------------------
project/synth_top/*
!project/synth_top/synth_top.gprj
project/instrument_top/*
!project/instrument_top/instrument_top.gprj
project/instrument_timbres_top/*
!project/instrument_timbres_top/instrument_timbres_top.gprj
project/instrument_24_rgb_top/*
!project/instrument_24_rgb_top/instrument_24_rgb_top.gprj
project/audio_a2_probe_top/*
!project/audio_a2_probe_top/audio_a2_probe_top.gprj
project/audio_poly_probe_top/*
!project/audio_poly_probe_top/audio_poly_probe_top.gprj
project/instrument_a2_review/
project/impl/
project/prj/
impl/
*.fs
*.bin
*.binx
*.db
*.vg
*.pr
*.p
*.log
*.prj
*.gao
*.bak
*.tmp
*.gprj.user
*.ipc
.temp/
*_bak/
*_process_config.json
rtl_parser.result
rtl_parser_arg.json
device.cfg
cmd.do
*_syn.rpt.html
*_syn_resource.html
*_syn_rsc.xml
*.pin.html
*.power.html
*.rpt.html
*.rpt.txt
*.tr.html
*_tr_content.html
*_tr_cata.html
*.timing_paths

# ---------------------------------------------------------------------------
# 2) ModelSim 仿真库与波形
#    sim/delta/ 与各 work 库每次仿真都会生成大量 .dat/.vhd/.psm
# ---------------------------------------------------------------------------
sim/delta/
sim/work*/
sim/instrument_24_rgb_build/
sim/run_*/
work/
*.vcd
*.wlf
*.sav
*.dsn
*.stx
transcript
modelsim.ini

# ---------------------------------------------------------------------------
# 3) 仿真工程工作目录（.gprj 保留，其余忽略）
# ---------------------------------------------------------------------------
sim/sim_scheduler/*.user
sim/sim_scheduler/*.log
sim/sim_scheduler/*.prj
sim/sim_scheduler/*_process_config.json

# ---------------------------------------------------------------------------
# 4) 其它仿真器 / 工具产物
# ---------------------------------------------------------------------------
obj_dir/
xsim.dir/
simv
simv.daidir
csrc/
*.jou
*.pbw
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# 5) 办公 / 压缩 / 大二进制
# ---------------------------------------------------------------------------
*.doc
*.docx
*.pdf
*.rar
*.zip
*.7z
*.exe
*.msi
*.iso

# ---------------------------------------------------------------------------
# 6) 操作系统与编辑器
# ---------------------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
*~
*.swp
.vscode/
.idea/

# ---------------------------------------------------------------------------
# 7) 敏感信息
# ---------------------------------------------------------------------------
*.license
*.lic
license*.txt

# ---------------------------------------------------------------------------
# 8) 本地参考资料 / 外部抓取（只留 URL 说明，不入库）
# ---------------------------------------------------------------------------
_ref/
_extract/
