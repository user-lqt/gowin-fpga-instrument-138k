//=============================================================================
// tang_mega138k.sdc —— 时序约束
//
// 归属：成员 C 独占维护。
//
// 时钟结构（见 rtl/system/clock_gen.v）：
//   i_clk_in  50 MHz 输入参考   （板载晶振，管脚 V22）
//   clk_audio 12.29167 MHz 音频域（PLL CLKOUT0）
//   clk_sys   98.333 MHz 系统域 （PLL CLKOUT1）
//
// PLL 输出时钟由工具从原语自动推导，一般不需要手工 create_clock。
// 这里约束输入参考时钟与异步输入。
//=============================================================================

//-----------------------------------------------------------------------------
// 1. 输入参考时钟：板载 50 MHz 晶振（V22），周期 20 ns
//    换晶振时必须同步修改这里与 clock_gen.v 的分频参数
//-----------------------------------------------------------------------------
create_clock -name clk_in -period 20.000 [get_ports {i_clk_in}]

//-----------------------------------------------------------------------------
// 2. 异步输入
//    S2 复位键相对时钟异步，且其 BANK 为 1.5V
//-----------------------------------------------------------------------------
set_false_path -from [get_ports {i_rst_n}]

//-----------------------------------------------------------------------------
// 3. I2S 输出：低频数字输出，按参考时钟周期给宽松的输出延迟
//-----------------------------------------------------------------------------
set_output_delay -clock clk_in -max 20.000 [get_ports {o_hp_bck o_hp_ws o_hp_din o_pa_en}]

// 指示灯为低速信号，不需要时序约束
set_false_path -to [get_ports {o_led o_locked}]

//-----------------------------------------------------------------------------
// 待办
//   [ ] 阶段 1 上板后检查 WNS >= 0（报告在 impl/pnr/*.rpt.txt）
//   [ ] 若需精确评估音频域时序，可为 PLL 输出补 create_clock
//-----------------------------------------------------------------------------
