//=============================================================================
// tang_mega138k.cst —— 物理约束（管脚分配）
//
// 归属：成员 C 独占维护。A/B 不得修改。
//
// 器件信息（已核实）：
//   DEVICE        : GW5AST-LV138PG484AC1/I0
//   IDE 封装选择   : PBG484A
//   DEVICE VER    : B（Sipeed 官方例程 audio.cst 标头为 "Device Version: B"）
//                   上板前请用实物丝印复核；若为 C 版请改这里并重新综合。
//   核对日期       : 2026-09-21
//   依据           : sipeed/TangMega-138K-example → audio_i2s/eda_proj/src/audio.cst
//                   （官方 I2S 出声例程的约束文件，管脚可直接采信）
//
// 本文件已完成部分：I2S 音频输出三线 + 音频功放使能 + 复位键 + LED
// 本文件未完成部分：键盘 / 编码器 / OLED / UART —— 见文件末尾待办
//
// 安全红线：外接 GPIO 只允许 3.3V；HC-SR04 的 ECHO 必须分压后接入。
//=============================================================================

//-----------------------------------------------------------------------------
// I2S 音频输出  ★ 已核实 —— 来自 Sipeed 官方例程的实机约束
//
//   信号命名沿用官方约束，避免与硬件原理图脱节：
//     HP_BCK  = 位时钟（官方例用 1.536 MHz；本设计用 3.072 MHz 以支持 24bit）
//     HP_WS   = 声道选择（低电平 = 左声道）
//     HP_DIN  = DAC 串行数据
//     PA_EN   = 板载音频功放使能（高电平有效）
//
//   ★ 结论：板载 DAC + 功放已完整存在，无需外置 PCM5102A / PAM8403
//-----------------------------------------------------------------------------
IO_LOC  "HP_BCK"  Y17;
IO_PORT "HP_BCK"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "HP_WS"   AB17;
IO_PORT "HP_WS"   IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "HP_DIN"  AA16;
IO_PORT "HP_DIN"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PA_EN"   AB16;
IO_PORT "PA_EN"   IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

//-----------------------------------------------------------------------------
// 复位与指示灯  ★ 已核实
//-----------------------------------------------------------------------------
// S2 按键作复位。注意：此管脚的 BANK_VCCIO 为 1.5V，官方用 LVCMOS15
IO_LOC  "rst_ext" F4;
IO_PORT "rst_ext" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;

IO_LOC  "led" W21;
IO_PORT "led" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

//=============================================================================
