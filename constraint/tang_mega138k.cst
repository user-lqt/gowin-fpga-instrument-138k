//=============================================================================
// tang_mega138k.cst —— 物理约束（管脚分配）
//
// 归属：成员 C 独占维护。
//
// 器件信息（已核实）：
//   DEVICE      : GW5AST-LV138PG484AC1/I0
//   IDE 封装选择 : PBG484A
//   DEVICE VER  : B（依据 Sipeed 官方例程 audio.cst 标头；上板前请复核丝印）
//   核对日期     : 2026-09-21
//   管脚依据     : sipeed/TangMega-138K-example -> audio_i2s/eda_proj/src/audio.cst
//                  （官方 I2S 出声例程的实机约束，可信）
//
// 端口名与本工程顶层（synth_check_top / 后续 synth_top）保持一致。
//
// 安全红线：外接 GPIO 只允许 3.3V；HC-SR04 的 ECHO 必须分压后接入。
//=============================================================================

//-----------------------------------------------------------------------------
// 时钟输入（50 MHz 参考）
// TODO: 确认板载可用时钟源与管脚后替换
//-----------------------------------------------------------------------------
// IO_LOC  "i_clk_in"  TODO_PIN;
// IO_PORT "i_clk_in"  IO_TYPE=LVCMOS33 PULL_MODE=UP;

//-----------------------------------------------------------------------------
// I2S 音频输出  ★ 来自官方例程，可直接采信
//   o_hp_bck = 位时钟（官方例 1.536 MHz；本设计 3.072 MHz）
//   o_hp_ws  = 声道选择（低电平 = 左声道）
//   o_hp_din = DAC 串行数据
//   o_pa_en  = 板载音频功放使能（高电平有效）
//-----------------------------------------------------------------------------
IO_LOC  "o_hp_bck"  Y17;
IO_PORT "o_hp_bck"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_hp_ws"   AB17;
IO_PORT "o_hp_ws"   IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_hp_din"  AA16;
IO_PORT "o_hp_din"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_pa_en"   AB16;
IO_PORT "o_pa_en"   IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

//-----------------------------------------------------------------------------
// 复位 S2 与指示灯  ★ 来自官方例程
//   S2 按键所在 BANK_VCCIO 为 1.5V，必须用 LVCMOS15
//-----------------------------------------------------------------------------
IO_LOC  "i_rst_n"  F4;
IO_PORT "i_rst_n"  IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;

IO_LOC  "o_led"    W21;
IO_PORT "o_led"    IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "o_locked" W22;
IO_PORT "o_locked" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

