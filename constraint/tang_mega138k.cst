//=============================================================================
// tang_mega138k.cst —— 物理约束（管脚分配）
//
// 归属：成员 C 独占维护。A/B 不得修改。
//
// ⚠️ 本文件当前是【模板】，管脚号全部是占位符，直接使用会烧不出正确功能。
//    必须按下列步骤填写后才能上板：
//      1) 确认实物器件版本（B/C），把结论写到下面 DEVICE 注释里；
//      2) 打开 Sipeed 官方原理图，逐个信号查出 FPGA 管脚号；
//      3) 交叉核对 UG986-1.2.7_GW5AST-138 器件 Pinout 手册的管脚定义；
//      4) 每填一项，在行的末尾标注来源（原理图页码 / 手册页码）。
//
// 器件信息（已核实）：
//   DEVICE      : GW5AST-LV138PG484AC1/I0
//   IDE 封装选择 : PBG484A
//   DEVICE VER  : TODO —— 按实物丝印填写 B 或 C
//   核对日期     : TODO
//   核对人       : TODO
//
// 安全红线：外接 GPIO 只允许 3.3V；HC-SR04 的 ECHO 必须分压后接入。
//=============================================================================

//-----------------------------------------------------------------------------
// 时钟与复位
//-----------------------------------------------------------------------------
// 来源：TODO（Sipeed 原理图 第 __ 页）
IO_LOC  "clk_50m" TODO_PIN;
IO_PORT "clk_50m" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// 外部复位（用户按键之一，低有效）
IO_LOC  "rst_n_ext" TODO_PIN;
IO_PORT "rst_n_ext" IO_TYPE=LVCMOS33 PULL_MODE=UP;

//-----------------------------------------------------------------------------
// 按键与 LED（板载）
//-----------------------------------------------------------------------------
// 3 个用户按键 + 4 个电池指示 LED + 8 个 PMOD_LED
IO_LOC  "key[0]" TODO_PIN;
IO_LOC  "key[1]" TODO_PIN;
IO_LOC  "key[2]" TODO_PIN;
IO_PORT "key[2:0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "led[7:0]" TODO_PIN_BASE;
IO_PORT "led[7:0]" IO_TYPE=LVCMOS33 DRIVE=8;

//-----------------------------------------------------------------------------
// I2S 音频输出（→ PCM5102A 或板载音频通路）
//   i2s_bck  = 64 x LRCK = 3.072 MHz
//   i2s_lrck = 48 kHz
//   i2s_data = 24bit 左对齐置于 32bit 槽高位
//-----------------------------------------------------------------------------
// 来源：TODO（Sipeed 原理图 第 __ 页；UG986 第 __ 页核对）
IO_LOC  "i2s_bck"  TODO_PIN;
IO_LOC  "i2s_lrck" TODO_PIN;
IO_LOC  "i2s_data" TODO_PIN;
IO_PORT "i2s_bck"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "i2s_lrck" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "i2s_data" IO_TYPE=LVCMOS33 DRIVE=8;

//-----------------------------------------------------------------------------
// 矩阵键盘（4x4 x 2）—— 成员 B
//   行输出：FPGA 驱动；列输入：内部上拉 + 10k 外部上拉至 3.3V
//-----------------------------------------------------------------------------
IO_LOC  "kb_row[3:0]" TODO_PIN_BASE;
IO_PORT "kb_row[3:0]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_LOC  "kb_col[7:0]" TODO_PIN_BASE;
IO_PORT "kb_col[7:0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

//-----------------------------------------------------------------------------
// EC11 旋转编码器 —— 成员 B
//-----------------------------------------------------------------------------
IO_LOC  "enc_a" TODO_PIN;
IO_LOC  "enc_b" TODO_PIN;
IO_LOC  "enc_btn" TODO_PIN;
IO_PORT "enc_a" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "enc_b" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "enc_btn" IO_TYPE=LVCMOS33 PULL_MODE=UP;

//-----------------------------------------------------------------------------
// OLED SSD1306 (I2C, 3.3V, 四针版) —— 低级 I2C 时序由 C 维护
//-----------------------------------------------------------------------------
IO_LOC  "oled_scl" TODO_PIN;
IO_LOC  "oled_sda" TODO_PIN;
IO_PORT "oled_scl" IO_TYPE=LVCMOS33 DRIVE=8 OPENDRAIN=ON;
IO_PORT "oled_sda" IO_TYPE=LVCMOS33 DRIVE=8 OPENDRAIN=ON;

//-----------------------------------------------------------------------------
// 调试串口（可走板载 USB JTAG&UART）
//-----------------------------------------------------------------------------
IO_LOC  "uart_tx" TODO_PIN;
IO_LOC  "uart_rx" TODO_PIN;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

//-----------------------------------------------------------------------------
// 待办清单（阶段 0 内必须全部完成）
//   [ ] 器件版本 B/C 确认并填入文件头
//   [ ] I2S 三线管脚号确认
//   [ ] 按键 / LED 管脚号确认
//   [ ] 键盘 / 编码器 / OLED / UART 管脚号确认
//   [ ] 全部 IO_TYPE 与板上实际电平一致（只允许 3.3V）
//   [ ] 与 synth_top.v 的端口名逐一对齐
//-----------------------------------------------------------------------------
